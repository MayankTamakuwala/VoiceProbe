# ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# only for docker compose, defaults to the host's ollama
# COMPOSE_OLLAMA_HOST=http://ollama:11434

# speech
WHISPER_MODEL=base.en
PIPER_VOICE=en_US-lessac-medium

# reference agent
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# booking api
BOOKING_HOST=127.0.0.1
BOOKING_PORT=8001
BOOKING_DB=data/bookings.db
BOOKING_URL=http://127.0.0.1:8001

# elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
